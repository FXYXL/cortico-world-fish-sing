{
  "schema": 1,
  "name": "cortico-world-fish-sing",
  "version": "0.6.0",
  "describe": {
    "tools": [
      {
        "name": "fish_sing",
        "description": "把一首歌换成她的声音唱出来，本机放或发 QQ 语音条。",
        "summary": {
          "zh": "唱一首歌（歌名 / BV 号 / 本地文件）",
          "en": "Sing a song in her voice"
        },
        "tags": [
          "music",
          "voice"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "song": {
              "type": "string",
              "description": "歌名、BV 号、链接或本机文件路径"
            },
            "to": {
              "type": "string",
              "description": "local / group:<群号> / private:<QQ号> / both"
            },
            "mode": {
              "type": "string",
              "enum": [
                "full",
                "vocals"
              ],
              "description": "带伴奏 / 清唱"
            },
            "pitch": {
              "type": [
                "number",
                "string"
              ],
              "description": "移调半音，或传 auto 按模型音域自动推荐"
            },
            "indexRate": {
              "type": "number",
              "description": "音色检索强度 0~1"
            },
            "protect": {
              "type": "number",
              "description": "气声保护 0~0.5"
            },
            "rmsMixRate": {
              "type": "number",
              "description": "音量跟随原唱程度 0~1（0=完全跟随，1=不跟随）"
            },
            "start": {
              "type": "number",
              "description": "从第几秒开始"
            },
            "duration": {
              "type": "number",
              "description": "唱多长（秒）"
            },
            "refresh": {
              "type": "boolean",
              "description": "忽略缓存"
            },
            "search": {
              "type": "boolean",
              "description": "只搜索不下载，返回候选列表"
            },
            "pick": {
              "type": "string",
              "description": "选定序号或 BV"
            },
            "order": {
              "type": "string",
              "enum": [
                "default",
                "click",
                "pubdate"
              ],
              "description": "B 站排序"
            },
            "f0Method": {
              "type": "string",
              "enum": [
                "rmvpe",
                "fcpe"
              ],
              "description": "音高提取算法（rmvpe / fcpe）"
            },
            "separator": {
              "type": "string",
              "enum": [
                "htdemucs",
                "roformer"
              ],
              "description": "人声分离档位（htdemucs 快速 / roformer UVR5精唱）"
            },
            "dereverb": {
              "type": "boolean",
              "description": "分离后是否额外去混响"
            },
            "karaoke": {
              "type": "boolean",
              "description": "分离后是否额外去原唱伴唱和声（UVR5 Karaoke）"
            },
            "model": {
              "type": "string",
              "description": "临时指定本次演唱使用的音色模型（可先调 fish_sing_status 查看全部可用模型）"
            },
            "duetModel": {
              "type": "string",
              "description": "双音色真合唱搭档模型（与主模型交替对唱或副歌双声部合唱）"
            },
            "duetMode": {
              "type": "string",
              "enum": [
                "alternate",
                "unison"
              ],
              "description": "合唱模式（alternate 主歌对唱+副歌真合唱 / unison 全程双声部合唱）"
            },
            "dynamicStyle": {
              "type": "string",
              "enum": [
                "off",
                "soft-verse-bright-chorus"
              ],
              "description": "主副歌动态演绎（主歌柔、副歌亮）"
            },
            "segments": {
              "type": "array",
              "description": "显式分段换音色/参数"
            },
            "async": {
              "type": "boolean",
              "description": "异步后台准备并自动开唱"
            },
            "ignoreRecipe": {
              "type": "boolean",
              "description": "是否忽略拿手歌本里的该曲最佳配方"
            },
            "lyricQuery": {
              "type": "string",
              "description": "可选指定准确歌名与歌手用于精准匹配时间轴歌词"
            }
          },
          "required": [
            "song"
          ]
        }
      },
      {
        "name": "fish_sing_patch",
        "description": "局部返工重唱/补录：只针对某一句、副歌或某几秒换参数或模型重跑，自动吸附静音边界无缝贴回原位。",
        "summary": {
          "zh": "局部返工补录",
          "en": "Patch and re-sing a line or section"
        },
        "tags": [
          "music",
          "voice"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "lines": {
              "type": "string",
              "description": "句号或范围，如 7 或 7-9"
            },
            "lyric": {
              "type": "string",
              "description": "歌词关键词"
            },
            "section": {
              "type": "string",
              "enum": [
                "chorus"
              ]
            },
            "chorusIndex": {
              "type": "number"
            },
            "atCurrent": {
              "type": "boolean",
              "description": "自动取当前正在唱的那一句"
            },
            "start": {
              "type": "number"
            },
            "end": {
              "type": "number"
            },
            "pitch": {
              "type": "number"
            },
            "indexRate": {
              "type": "number"
            },
            "protect": {
              "type": "number"
            },
            "rmsMixRate": {
              "type": "number"
            },
            "f0Method": {
              "type": "string",
              "enum": [
                "rmvpe",
                "fcpe"
              ]
            },
            "model": {
              "type": "string",
              "description": "临时换另一个音色模型来唱这一句（可先调 fish_sing_status 查看本机全部可用模型）"
            },
            "previewOnly": {
              "type": "boolean"
            },
            "autoFix": {
              "type": "boolean",
              "description": "一键自动修补声学体检标出的所有破音/越界问题段"
            },
            "to": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      {
        "name": "fish_sing_lyrics",
        "description": "查看最近一首歌的时间轴歌词表、当前播到第几句以及声学体检报告；支持微调或重置歌词时间轴偏移。",
        "summary": {
          "zh": "歌词与体检",
          "en": "Lyrics timeline and vocal inspection"
        },
        "tags": [
          "music"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "fromLine": {
              "type": "number"
            },
            "limit": {
              "type": "number"
            },
            "refresh": {
              "type": "boolean"
            },
            "query": {
              "type": "string",
              "description": "手动指定准确歌名/歌手重新联网匹配歌词"
            },
            "offsetSec": {
              "type": "number",
              "description": "相对微调歌词偏移秒数（正数延后、负数提前）"
            },
            "resetOffset": {
              "type": "boolean",
              "description": "重置歌词时间轴偏移为 0"
            }
          },
          "required": []
        }
      },
      {
        "name": "fish_sing_seek",
        "description": "从任意一句、副歌或指定秒数直接跳播最近一首唱过的歌。",
        "summary": {
          "zh": "跳播指定句或副歌",
          "en": "Seek playback to a line or chorus"
        },
        "tags": [
          "music"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "line": {
              "type": "number",
              "description": "跳到第几句开始播（1 基句号）"
            },
            "lyric": {
              "type": "string",
              "description": "按歌词关键词跳播"
            },
            "section": {
              "type": "string",
              "enum": [
                "chorus"
              ],
              "description": "跳到副歌开头"
            },
            "chorusIndex": {
              "type": "number",
              "description": "第几段副歌（从 1 开始）"
            },
            "sec": {
              "type": "number",
              "description": "直接跳到第几秒"
            }
          },
          "required": []
        }
      },
      {
        "name": "fish_sing_stop",
        "description": "停掉播放并取消正在处理的歌。",
        "summary": {
          "zh": "别唱了",
          "en": "Stop singing"
        },
        "tags": [
          "music"
        ],
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "name": "fish_sing_queue",
        "description": "点歌队列与小歌会连唱：一次排多首歌连续唱、边唱边后台预热下一首、切歌、切换循环模式或一键排入拿手歌会。",
        "summary": {
          "zh": "点歌队列 / 连唱",
          "en": "Singing queue and continuous mode"
        },
        "tags": [
          "music"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "add",
                "next",
                "remove",
                "clear",
                "mode",
                "repertoire"
              ]
            },
            "song": {
              "type": "string"
            },
            "songs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "front": {
              "type": "boolean"
            },
            "query": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "sequence",
                "loop-one",
                "loop-all"
              ]
            },
            "tag": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "pitch": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      {
        "name": "fish_sing_library",
        "description": "列出 / 回放 / 删除她唱过的歌。",
        "summary": {
          "zh": "作品库",
          "en": "Song library"
        },
        "tags": [
          "music"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "play",
                "send",
                "delete"
              ]
            },
            "query": {
              "type": "string"
            },
            "to": {
              "type": "string",
              "description": "发到 QQ 的目标：group:<群号> 或 private:<QQ号>（配合 send 或 play 使用）"
            },
            "limit": {
              "type": "number"
            }
          },
          "required": []
        }
      },
      {
        "name": "fish_sing_repertoire",
        "description": "个人拿手歌本与唱法记忆：列出、收藏最佳配方与心得、或按标签挑一首拿手曲开播。",
        "summary": {
          "zh": "拿手歌本",
          "en": "Personal singing repertoire"
        },
        "tags": [
          "music"
        ],
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "save",
                "pick",
                "remove"
              ]
            },
            "query": {
              "type": "string"
            },
            "tags": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "favorite": {
              "type": "boolean"
            },
            "tag": {
              "type": "string"
            },
            "play": {
              "type": "boolean"
            }
          },
          "required": []
        }
      },
      {
        "name": "fish_sing_status",
        "description": "唱歌功能是否可用、当前在算什么。",
        "summary": {
          "zh": "唱歌状态",
          "en": "Singing status"
        },
        "tags": [
          "music"
        ],
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    ],
    "events": [
      {
        "type": "fishsing.started",
        "description": "异步点歌准备完成并开始播放（含声学体检与歌词时间轴提示）"
      },
      {
        "type": "fishsing.lyric",
        "description": "唱中提词预告（进副歌前提前预告或按配置间隔推送下一句歌词）"
      },
      {
        "type": "fishsing.ended",
        "description": "歌曲自然播放结束，可自然接话询问是否再来或返工"
      },
      {
        "type": "fishsing.error",
        "description": "异步点歌失败或需要挑选候选"
      }
    ],
    "prompts": [
      {
        "key": "fish-sing.envPrompt",
        "title": "唱歌环境提示词",
        "role": "envPrompt",
        "content": "你能用自己的声音唱歌（fish_sing）。默认只在本机播放；要发 QQ 才给 to。一首歌 60~120 秒，同时只能唱一首。"
      }
    ]
  }
}
